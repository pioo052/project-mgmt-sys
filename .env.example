# URIMS database connection (copy to .env for local use, or set these in your
# Railway service variables). Never commit real credentials.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urims
DB_USER=root
DB_PASS=

# Railway MySQL services also expose MYSQLHOST, MYSQLPORT, MYSQLDATABASE,
# MYSQLUSER, MYSQLPASSWORD and MYSQL_URL. They are read automatically when the
# DB_* names above are not set, so either naming works.

# Optional: skip the schema bootstrap in start.sh.
# URIMS_SKIP_DB_BOOTSTRAP=0

# Optional: base path override when the app is served from a subdirectory.
# URIMS_BASE_PATH=
